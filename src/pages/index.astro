---
import BaseLayout from "../layouts/BaseLayout.astro";
import { site } from "../data/site";
import { getPublishedContent, contentIndex, homeLimit } from "../lib/content";
import EntryList from "../components/EntryList.astro";
const entries = contentIndex(await getPublishedContent(), true).slice(0, homeLimit);
---

<BaseLayout>
  <section class="hero">
    <div class="hero-copy">
      <p class="eyebrow"><span data-copy="zh">问题 / 实验 / 音乐</span><span data-copy="en">QUESTIONS / EXPERIMENTS / MUSIC</span></p>
      <h1>
        <span data-copy="zh">留下一些，
          我觉得有趣的东西。</span>
        <span data-copy="en">Things I find interesting.</span>
      </h1>
      <p class="hero-lead">
        <span data-copy="zh">{site.description.zh}</span>
        <span data-copy="en">{site.description.en}</span>
      </p>
    </div>
    <aside class="hero-index">
      <img class="profile-avatar" src="/fox/clean-pose-0.png" alt="" width="144" height="144" />
      <span><span data-copy="zh">个人空间</span><span data-copy="en">A PERSONAL SPACE</span></span>
      <strong>{site.handle}</strong>
      <a href={site.github} target="_blank" rel="noreferrer">github.com/mrShaoGu ↗</a>
    </aside>
  </section>

  {entries.length > 0 && <section class="content-section" id="selected">
    <header class="section-heading">
      <p><span data-copy="zh">一些选择</span><span data-copy="en">A SELECTION</span></p>
      <h2><span data-copy="zh">值得停留的东西</span><span data-copy="en">Stay a while.</span></h2>
    </header>
    <EntryList entries={entries} />
  </section>}

  <p class="archive-link"><a href="/archive/"><span data-copy="zh">浏览全部记录 →</span><span data-copy="en">Browse all entries →</span></a></p>

  <section class="about" id="about">
    <h2><span data-copy="zh">关于这里</span><span data-copy="en">About this place</span></h2>
    <div class="about-main">
      <p><span data-copy="zh">{site.introduction.zh}</span><span data-copy="en">{site.introduction.en}</span></p>
      <div class="about-links">
        <a href={site.github} target="_blank" rel="noreferrer">GitHub ↗</a>
        {site.bilibili && <a href={site.bilibili} target="_blank" rel="noreferrer">Bilibili ↗</a>}
        {site.email && <a href={`mailto:${site.email}`}>Email ↗</a>}
      </div>
    </div>
  </section>
</BaseLayout>

